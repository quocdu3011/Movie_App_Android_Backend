{
  "name": "movieapp-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "lint": "eslint apps libs scripts test --max-warnings=0",
    "test:unit": "node --test dist/libs/**/*.test.js",
    "test:g0": "node test/g0-smoke.mjs",
    "test": "npm run build && npm run test:unit && npm run test:g0",
    "start:auth": "node dist/apps/auth-service/main.js",
    "start:gateway": "node dist/apps/api-gateway/main.js",
    "start:profile": "node dist/apps/profile-service/main.js",
    "start:catalog": "node dist/apps/catalog-service/main.js",
    "start:payment": "node dist/apps/payment-service/main.js",
    "start:streaming": "node dist/apps/streaming-service/main.js",
    "start:worker": "node dist/apps/transcode-worker/main.js",
    "start:notification": "node dist/apps/notification-service/main.js",
    "start:recommendation": "node dist/apps/recommendation-service/main.js",
    "dev:auth": "node --watch -r ts-node/register apps/auth-service/src/main.ts",
    "dev:gateway": "node --watch -r ts-node/register apps/api-gateway/src/main.ts",
    "migration:run": "typeorm-ts-node-commonjs -d apps/auth-service/src/database/data-source.ts migration:run",
    "migration:show": "typeorm-ts-node-commonjs -d apps/auth-service/src/database/data-source.ts migration:show",
    "migration:profile:run": "typeorm-ts-node-commonjs -d apps/profile-service/src/database/data-source.ts migration:run",
    "migration:profile:show": "typeorm-ts-node-commonjs -d apps/profile-service/src/database/data-source.ts migration:show",
    "migration:catalog:run": "typeorm-ts-node-commonjs -d apps/catalog-service/src/database/data-source.ts migration:run",
    "migration:catalog:show": "typeorm-ts-node-commonjs -d apps/catalog-service/src/database/data-source.ts migration:show",
    "migration:payment:run": "typeorm-ts-node-commonjs -d apps/payment-service/src/database/data-source.ts migration:run",
    "migration:payment:show": "typeorm-ts-node-commonjs -d apps/payment-service/src/database/data-source.ts migration:show",
    "migration:streaming:run": "typeorm-ts-node-commonjs -d apps/streaming-service/src/database/data-source.ts migration:run",
    "migration:streaming:show": "typeorm-ts-node-commonjs -d apps/streaming-service/src/database/data-source.ts migration:show",
    "migration:worker:run": "typeorm-ts-node-commonjs -d apps/transcode-worker/src/database/data-source.ts migration:run",
    "migration:worker:show": "typeorm-ts-node-commonjs -d apps/transcode-worker/src/database/data-source.ts migration:show",
    "dev:keys": "bash scripts/generate-dev-keys.sh",
    "smoke:auth": "node test/auth-smoke.mjs",
    "smoke:auth-ci": "bash scripts/auth-e2e.sh",
    "smoke:profile-ci": "node test/profile-e2e.mjs",
    "smoke:catalog-ci": "node test/catalog-e2e.mjs",
    "smoke:payment-ci": "node test/payment-e2e.mjs",
    "smoke:streaming-ci": "node test/streaming-e2e.mjs",
    "smoke:owned-media-ci": "node test/owned-media-e2e.mjs",
    "smoke:kkphim-live": "npm run build && node test/kkphim-live-smoke.mjs",
    "infra:up": "bash scripts/infra-up.sh",
    "infra:bootstrap": "npm run bootstrap:postgres && bash scripts/bootstrap-kafka.sh",
    "infra:media": "bash scripts/infra-media-up.sh",
    "bootstrap:postgres": "node scripts/bootstrap-postgres.mjs",
    "infra:down": "bash scripts/infra-down.sh"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/typeorm": "11.0.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "eslint": "10.10.0",
    "ts-node": "10.9.2",
    "typeorm-ts-node-commonjs": "0.3.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "allowScripts": {
    "argon2@0.44.0": true
  }
}
