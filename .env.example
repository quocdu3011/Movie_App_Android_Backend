NODE_ENV=development
AUTH_PORT=3001
GATEWAY_PORT=3000
AUTH_DATABASE_URL=postgres://movieapp:movieapp_dev_only@localhost:5432/auth_db
AUTH_JWT_ISSUER=https://auth.movieapp.local
AUTH_JWT_AUDIENCE=movieapp-api
AUTH_JWT_KID=local-dev-2026-01
AUTH_JWKS_PREVIOUS_PUBLIC_KEYS_JSON={}
AUTH_PRIVATE_KEY_PATH=../.secrets/auth-private.pem
AUTH_PUBLIC_KEY_PATH=../.secrets/auth-public.pem
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_MAX_DEVICES=5
AUTH_SERVICE_URL=http://127.0.0.1:3001
AUTH_INTERNAL_TOKENS_JSON={"api-gateway":"replace-with-a-long-random-secret-at-least-32-chars"}
GATEWAY_SERVICE_TOKEN=replace-with-a-long-random-secret-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:8080
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Local Admin
