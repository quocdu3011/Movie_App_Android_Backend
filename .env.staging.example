# Copy to .env.staging and replace every REPLACE value in the secret store or CI environment.
# IMAGE_TAG must be a committed immutable SHA, e.g. sha-0123456789ab.
IMAGE_TAG=sha-REPLACE_WITH_GIT_SHA
STAGING_GATEWAY_PORT=3000
STAGING_MEDIA_EDGE_PORT=8081
AUTH_PRIVATE_KEY_FILE=./secrets/REPLACE-auth-private.pem
AUTH_PUBLIC_KEY_FILE=./secrets/REPLACE-auth-public.pem
AUTH_DATABASE_URL=postgres://movieapp:REPLACE@postgres:5432/auth_db
PROFILE_DATABASE_URL=postgres://movieapp_profile:REPLACE@postgres:5432/profile_db
CATALOG_DATABASE_URL=postgres://movieapp_catalog:REPLACE@postgres:5432/catalog_db
PAYMENT_DATABASE_URL=postgres://movieapp_payment:REPLACE@postgres:5432/payment_db
STREAMING_DATABASE_URL=postgres://movieapp_streaming:REPLACE@postgres:5432/streaming_db
WORKER_DATABASE_URL=postgres://movieapp_worker:REPLACE@postgres:5432/worker_db
NOTIFICATION_DATABASE_URL=postgres://movieapp_notification:REPLACE@postgres:5432/notification_db
RECOMMENDATION_DATABASE_URL=postgres://movieapp_recommendation:REPLACE@postgres:5432/recommendation_db
REDIS_URL=redis://:REPLACE@redis:6379/0
KAFKA_BROKERS=kafka:9092
# Managed OpenSearch. SERVICE_URI takes precedence over HOST and PORT.
OPENSEARCH_SERVICE_URI=https://search.example.invalid
OPENSEARCH_HOST=
OPENSEARCH_PORT=443
OPENSEARCH_USER=REPLACE
OPENSEARCH_PASSWORD=REPLACE
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=REPLACE
MINIO_ROOT_PASSWORD=REPLACE
MINIO_BUCKET_MEDIA=movieapp-media
AUTH_JWT_ISSUER=https://auth.staging.example.invalid
AUTH_JWT_AUDIENCE=movieapp-api
AUTH_JWT_KID=staging-REPLACE
AUTH_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS","streaming-service":"REPLACE_32_CHARACTERS"}
GATEWAY_SERVICE_TOKEN=REPLACE_32_CHARACTERS
PROFILE_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS","streaming-service":"REPLACE_32_CHARACTERS","catalog-service":"REPLACE_32_CHARACTERS","recommendation-service":"REPLACE_32_CHARACTERS"}
CATALOG_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS","streaming-service":"REPLACE_32_CHARACTERS","profile-service":"REPLACE_32_CHARACTERS","recommendation-service":"REPLACE_32_CHARACTERS"}
PAYMENT_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS","streaming-service":"REPLACE_32_CHARACTERS"}
STREAMING_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS","profile-service":"REPLACE_32_CHARACTERS","transcode-worker":"REPLACE_32_CHARACTERS"}
STREAMING_DOWNSTREAM_TOKENS_JSON={"auth-service":"REPLACE_32_CHARACTERS","profile-service":"REPLACE_32_CHARACTERS","catalog-service":"REPLACE_32_CHARACTERS","payment-service":"REPLACE_32_CHARACTERS"}
NOTIFICATION_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS"}
RECOMMENDATION_INTERNAL_TOKENS_JSON={"api-gateway":"REPLACE_32_CHARACTERS"}
PROFILE_CATALOG_TOKEN=REPLACE_32_CHARACTERS
PROFILE_STREAMING_TOKEN=REPLACE_32_CHARACTERS
RECOMMENDATION_CATALOG_TOKEN=REPLACE_32_CHARACTERS
RECOMMENDATION_PROFILE_TOKEN=REPLACE_32_CHARACTERS
WORKER_STREAMING_TOKEN=REPLACE_32_CHARACTERS
MEDIA_AUTH_SECRET=REPLACE_32_CHARACTERS
KKPHIM_API_BASE_URL=https://phimapi.com
KKPHIM_MEDIA_HOST_ALLOWLIST=*.example.invalid,example.invalid
STREAMING_CONCURRENT_LIMIT_ENABLED=false
KKPHIM_TIMEOUT_MS=5000
ALLOWED_ORIGINS=https://staging.example.invalid
